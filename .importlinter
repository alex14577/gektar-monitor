[importlinter]
root_packages =
    fis_monitor
    tests
include_external_packages = True
# include_external_packages = True требуется для domain_purity:
#   forbidden_modules перечисляет stdlib/3rd-party (sqlite3, requests, fastapi,
#   playwright, smtplib) — без этого флага import-linter их не резолвит.

[importlinter:contract:layers]
name = Layered architecture
type = layers
layers =
    (fis_monitor.composition) | (fis_monitor.app)
    fis_monitor.web
    fis_monitor.services
    fis_monitor.infra
    fis_monitor.domain

[importlinter:contract:domain_purity]
name = Domain doesn't touch infrastructure libs
type = forbidden
source_modules = fis_monitor.domain
forbidden_modules = sqlite3, requests, fastapi, playwright, smtplib

[importlinter:contract:domain_no_logging]
name = Domain doesn't import the stdlib logging module
type = forbidden
source_modules = fis_monitor.domain
forbidden_modules = logging

[importlinter:contract:no-sqlite-in-unit-services]
name = No sqlite3 in unit service or domain tests (ADR-041 §Layer location rule)
type = forbidden
source_modules =
    tests.unit.services
    tests.unit.domain
forbidden_modules = sqlite3

[importlinter:contract:licensing-cli-not-in-app-graph]
name = licensing.cli not reachable from app entry-point (ADR-057 PyInstaller invariant)
type = forbidden
source_modules =
    fis_monitor.app
    fis_monitor.composition
    fis_monitor.web
    fis_monitor.services
    fis_monitor.infra
    fis_monitor.domain
forbidden_modules = fis_monitor.licensing.cli
