{# ========================================================================
   base.html — общий layout: header, sidebar, основная зона.
   Подключает CSS/JS и HTMX. Дочерние шаблоны заполняют:
     {% block main %}…{% endblock %}
   и опционально:
     {% block sidebar %}…{% endblock %}
     {% block header_extras %}…{% endblock %}
     {% block fs %}…{% endblock %}    — full-screen takeover (wizard, modal)
   ======================================================================== #}
<!doctype html>
<html lang="ru" data-tab-title="{{ title_format | default('(N) Монитор гектара') }}">
<head>
  <meta charset="utf-8" />
  <title>{{ tab_title | default('Монитор гектара') }}</title>
  <meta name="viewport" content="width=1366" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" />

  <link rel="stylesheet" href="{{ url_for('static', path='/app.css') }}" />
  <style>
    {# user-controlled font size from Settings (14/16/18) #}
    :root { --fs-base: {{ settings.font_size_px | default(16) }}px; }
  </style>

  <link rel="icon" type="image/svg+xml" href="{{ url_for('static', path='/favicon.svg') }}" />

  {# HTMX + SSE extension — vendored locally (supply-chain mitigation ADR-029). #}
  <script defer src="{{ url_for('static', path='/vendor/htmx-1.9.12/htmx.min.js') }}"></script>
  <script defer src="{{ url_for('static', path='/vendor/htmx-1.9.12/ext/sse.js') }}"></script>
</head>
<body>

  {# ============== Full-screen takeover (wizard, expired-session modal) ============== #}
  {% if self.fs() | trim %}
    {% block fs %}{% endblock %}
  {% else %}

  {# ============== Sticky header ============== #}
  <header class="header" role="banner">
    <a class="brand" href="/" aria-label="Монитор гектара — на главную">
      <span class="brand__mark" aria-hidden="true">М</span>
      <span>Монитор&nbsp;гектара</span>
    </a>

    {# SSE-driven status: server pushes <span hx-swap-oob> updates #}
    <div id="header-status" class="header__center"
         hx-ext="sse"
         sse-connect="/events"
         sse-swap="status"
         role="region" aria-label="Статус мониторинга">
      {% include "partials/_header_status.html.jinja" %}
    </div>

    <div class="header__right">
      <button class="btn btn--sm" type="button"
              hx-post="/cycle/run"
              hx-target="#cycle-result"
              hx-swap="innerHTML"
              hx-indicator="#cycle-spinner">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/></svg>
        Проверить сейчас
      </button>
      <span id="cycle-spinner" class="htmx-indicator spinner-dots" aria-hidden="true">
        <span class="spinner-dots__dot"></span>
        <span class="spinner-dots__dot"></span>
        <span class="spinner-dots__dot"></span>
      </span>
      <span id="cycle-result" class="cycle-result-host" role="status" aria-live="polite"></span>

      <div style="position:relative;">
        <button class="btn btn--sm btn--ghost" type="button"
                data-toggle-menu="dnd-menu" aria-haspopup="true" aria-expanded="false">
          {% if dnd.active %}🌙 До {{ dnd.until_hhmm }}{% else %}🌙 Не беспокоить{% endif %}
        </button>
        <div id="dnd-menu" data-menu hidden
             style="position:absolute; right:0; top: calc(100% + 6px); background: var(--surface); border: 1px solid var(--line); border-radius: 8px; box-shadow: var(--shadow); padding: 6px; min-width: 200px; z-index: 40;">
          <button class="btn btn--ghost btn--sm" data-action="dnd-preset" data-minutes="60"
                  hx-post="/dnd" hx-vals='{"minutes": 60}'  style="width:100%; justify-content:flex-start;">На 1 час</button>
          <button class="btn btn--ghost btn--sm" data-action="dnd-preset" data-minutes="180"
                  hx-post="/dnd" hx-vals='{"minutes": 180}' style="width:100%; justify-content:flex-start;">На 3 часа</button>
          <button class="btn btn--ghost btn--sm" data-action="dnd-preset" data-minutes="600"
                  hx-post="/dnd" hx-vals='{"minutes": 600}' style="width:100%; justify-content:flex-start;">До утра</button>
          <button class="btn btn--ghost btn--sm" style="width:100%; justify-content:flex-start;"
                  hx-get="/dnd/custom" hx-target="body" hx-swap="beforeend">Своё время…</button>
        </div>
      </div>

      <a class="btn btn--sm btn--ghost" href="/notifications" aria-label="Уведомления">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10 21a2 2 0 0 0 4 0"/></svg>
      </a>
      <a class="btn btn--sm btn--ghost btn--icon" href="/settings" aria-label="Настройки">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1A1.7 1.7 0 0 0 9 19.4a1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg>
      </a>
      {% block header_extras %}{% endblock %}
    </div>
  </header>

  <div class="app">
    <aside class="sidebar" aria-label="Боковая панель">
      {% block sidebar %}{% endblock %}
    </aside>

    <main class="app__main">
      {% block main %}{% endblock %}
    </main>
  </div>

  {# Expired-session modal (rendered, hidden until SSE flips it) #}
  <div id="session-expired-modal" class="modal-backdrop"
       {% if not session.expired %}hidden{% endif %}
       hx-ext="sse" sse-connect="/events" sse-swap="expired"
       role="dialog" aria-modal="true" aria-labelledby="ses-title">
    <div class="modal">
      <h2 id="ses-title">Сессия истекла</h2>
      <p>Войдите через Госуслуги, чтобы продолжить мониторинг.</p>
      <button class="btn btn--primary btn--lg btn--full" type="button" data-action="login-start">
        Войти через Госуслуги
      </button>
      <p style="margin: 12px 0 0; font-size: 0.8125rem; color: var(--muted);">
        Логин в отдельном окне браузера. Приложение никогда не видит ваш пароль.
      </p>
    </div>
  </div>

  {# aria-live regions #}
  <div id="__live_polite" class="sr-only" aria-live="polite"    aria-atomic="true"></div>
  <div id="__live_assert" class="sr-only" aria-live="assertive" aria-atomic="true"></div>

  {% endif %}

  <script defer src="{{ url_for('static', path='/app.js') }}"></script>
  <script defer src="{{ url_for('static', path='/auth.js') }}"></script>
</body>
</html>
