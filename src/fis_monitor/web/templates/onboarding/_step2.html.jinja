{# Step 2 — SMTP-настройки бот-ящика (отправителя) #}
{% if data.error %}<div style="color:#c00; padding:8px 0; font-size:.875rem;" role="alert">{{ data.error }}</div>{% endif %}
<h1>Почтовый ящик бота</h1>
<p class="wiz__sub">
  Приложение отправляет уведомления <b>от имени отдельного ящика</b>,
  например&nbsp;<span class="mono">monitor-bot@вашдомен.ру</span>. Это нужно, чтобы письма не приходили с вашего личного адреса.
  Введите SMTP-настройки этого ящика — мы проверим, что подключение работает.
</p>

<div class="field" style="max-width: 560px;">

  <div style="margin-top: 12px;">
    <label class="field__label" for="smtp-login">Логин (адрес ящика бота)</label>
    <input class="input" id="smtp-login" name="smtp_login" type="email"
           value="{{ data.smtp_login or '' }}" placeholder="monitor-bot@вашдомен.ру"
           autocomplete="username" required />
  </div>

  {# App-password hint — shown by JS when provider requires app-password #}
  <div id="smtp-app-password-hint" hidden
       style="margin-top: 8px; font-size: 0.8125rem; color: var(--ink-2);">
    <span id="smtp-provider-label"></span> требует <b>пароль приложения</b>
    (не обычный пароль аккаунта).
    <a id="smtp-app-password-link" href="#" target="_blank" rel="noopener noreferrer">
      Создать пароль приложения →
    </a>
  </div>

  <div style="margin-top: 12px;">
    <label class="field__label" for="smtp-pass">Пароль ящика</label>
    <div style="position: relative;">
      <input class="input" id="smtp-pass" name="smtp_pass" type="password"
             placeholder="••••••••••••" autocomplete="new-password" required
             style="padding-right: 44px;" />
      <button type="button" id="toggle-pass"
              aria-label="Показать пароль" aria-pressed="false"
              style="position:absolute; right:6px; top:50%; transform:translateY(-50%); width:32px; height:32px; display:grid; place-items:center; border:0; background:transparent; cursor:pointer; color: var(--muted); border-radius: 4px;"
              onclick="const p=document.getElementById('smtp-pass'); const s=p.type==='text'; p.type=s?'password':'text'; this.setAttribute('aria-pressed', String(!s));">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
      </button>
    </div>
    <p style="font-size: 0.75rem; color: var(--muted); margin: 6px 0 0;">
      Пароль хранится локально в зашифрованном виде. Приложение работает только на вашем ПК.
    </p>
  </div>

  {# Advanced settings — host/port hidden when a catalog suggestion is active #}
  <details id="smtp-advanced" style="margin-top: 16px;">
    <summary style="cursor: pointer; font-size: 0.875rem; color: var(--muted); user-select: none;">
      Расширенные настройки SMTP
    </summary>
    <div style="margin-top: 12px; display: grid; grid-template-columns: 1fr 120px; gap: 12px;">
      <div>
        <label class="field__label" for="smtp-host">SMTP-сервер</label>
        <input class="input" id="smtp-host" name="smtp_host" type="text"
               value="{{ data.smtp_host or '' }}" placeholder="smtp.yandex.ru"
               autocomplete="off" required />
      </div>
      <div>
        <label class="field__label" for="smtp-port">Порт</label>
        <input class="input mono" id="smtp-port" name="smtp_port" type="number"
               value="{{ data.smtp_port or 587 }}" min="1" max="65535" />
      </div>
    </div>
  </details>

  <div style="margin-top: 12px;">
    <label class="field__label" for="smtp-from">
      Имя отправителя <span style="color: var(--muted); font-weight: 400;">(необязательно)</span>
    </label>
    <input class="input" id="smtp-from" name="smtp_from_name" type="text"
           value="{{ data.smtp_from_name or 'Монитор гектара' }}" placeholder="Монитор гектара" />
  </div>

  <div style="margin-top: 16px; padding: 12px 14px; background: var(--surface-2); border-radius: 8px; font-size: 0.875rem; color: var(--ink-2);">
    <b>Нет своего ящика?</b> Заведите бесплатный на Яндекс.Почте или Mail.ru:
    создайте отдельный адрес для бота, включите «Пароль приложения» в настройках почты,
    и используйте его здесь.
    <span style="display: block; margin-top: 6px; color: var(--muted); font-size: 0.8125rem;">
      SMTP Яндекс: <span class="mono">smtp.yandex.ru : 465</span> ·
      Mail.ru: <span class="mono">smtp.mail.ru : 465</span> ·
      Gmail: <span class="mono">smtp.gmail.com : 587</span>
    </span>
  </div>
</div>

<script defer src="/static/onboarding_step2.js"></script>
