{# ========================================================================
   onboarding/wizard.html.jinja — full-screen wizard (4 шага).
   Сервер передаёт `step` (1..4) и формы предыдущих шагов через `data`.
   POST на /onboarding/save?step=N. Финальный шаг ставит flag onboarded=true
   и редиректит на /.
   ======================================================================== #}
{% extends "base.html.jinja" %}

{% block fs %}
  <div class="wiz" role="main">

    <header class="wiz__top">
      <a class="brand" href="#" aria-label="Монитор гектара">
        <span class="brand__mark" aria-hidden="true">М</span>
        <span>Монитор&nbsp;гектара</span>
      </a>
      <div class="wiz__dots" aria-label="Шаг {{ step }} из 4">
        {% for n in [1, 2, 3, 4] %}
          <span class="wiz__dot" data-on="{{ 'true' if n == step else 'false' }}"></span>
        {% endfor %}
      </div>
    </header>

    <form class="wiz__body"
          method="post"
          action="/onboarding/save?step={{ step }}"
          enctype="application/x-www-form-urlencoded"
          autocomplete="on">
      <div class="wiz__inner">
        {% if step == 1 %}
          {% include "onboarding/_step1.html.jinja" %}
        {% elif step == 2 %}
          {% include "onboarding/_step2.html.jinja" %}
        {% elif step == 3 %}
          {% include "onboarding/_step3.html.jinja" %}
        {% else %}
          {% include "onboarding/_step4.html.jinja" %}
        {% endif %}
      </div>

      <footer class="wiz__bottom">
        {% if step > 1 %}
          <a class="btn btn--ghost" href="/onboarding?step={{ step - 1 }}">← Назад</a>
        {% else %}<span></span>{% endif %}

        <span></span>

        <div style="display: flex; gap: 8px;">
          {% if step == 2 %}
            <button class="btn btn--ghost" type="submit" name="action" value="skip">Настроить позже</button>
          {% elif step == 3 %}
            <button class="btn btn--ghost" type="submit" name="action" value="skip">Пропустить — только браузерные</button>
          {% endif %}
          <button class="btn btn--primary btn--lg" type="submit" name="action" value="next">
            {{ 'Открыть панель →' if step == 4 else 'Дальше →' }}
          </button>
        </div>
      </footer>
    </form>

  </div>
{% endblock %}
