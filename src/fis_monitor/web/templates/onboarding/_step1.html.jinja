{# Step 1 — макрорегионы #}
{% if data.error %}<div style="color:#c00; padding:8px 0; font-size:.875rem;" role="alert">{{ data.error }}</div>{% endif %}
<h1>Какие регионы вам интересны?</h1>
<p class="wiz__sub">Лоты из выбранных округов будут собираться в базу. Можно изменить позже в Настройках.</p>

<div class="region-cards" role="group" aria-label="Макрорегионы">
  {% for r in [
      {'id': 'dfo',    'title': 'Дальневосточный<br/>федеральный округ',
       'desc':  '11 субъектов · Якутия, Камчатка, Приморский, Хабаровский, Сахалин, Магадан, Бурятия, Забайкалье, Амурская обл., ЕАО, Чукотка'},
      {'id': 'arctic', 'title': 'Арктическая зона',
       'desc':  '9 субъектов · Мурманская обл., Архангельская обл., Ненецкий АО, ЯНАО, Красноярский край (север), Якутия (север), Чукотка, Карелия (север), Коми (север)'}
  ] %}
  <button class="region-card" type="button"
          aria-pressed="{{ 'true' if r.id in data.regions else 'false' }}"
          onclick="this.setAttribute('aria-pressed', this.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
                   this.querySelector('input').checked = this.getAttribute('aria-pressed') === 'true';">
    <input type="checkbox" name="regions" value="{{ r.id }}"
           {% if r.id in data.regions %}checked{% endif %} hidden />
    <div class="region-card__check" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <div class="region-card__title">{{ r.title | safe }}</div>
    <div class="region-card__desc">{{ r.desc }}</div>
  </button>
  {% endfor %}
</div>
