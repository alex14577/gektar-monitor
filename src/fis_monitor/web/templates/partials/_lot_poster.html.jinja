{# ========================================================================
   _lot_poster.html.jinja — poster-карточка (для горячих/тёплых лотов).
   Используется как полный фрагмент SSE-event "lot.new" — сервер шлёт <article>…</article>.
   Ожидает переменную `lot` в контексте.

   hiq3: grid 1fr auto, was_new → lot-card--new accent border-left, dateformat filter,
   ОГВ без uppercase, inline copy-cadastre через [data-copy] delegation.
   ======================================================================== #}
<article class="lot lot--poster {% if lot.was_new %}lot-card--new{% endif %}"
         id="lot-{{ lot.id }}"
         data-lot-id="{{ lot.id }}"
         data-temp="{{ lot.temp }}"
         data-seen="{{ 'true' if lot.is_seen else 'false' }}"
         data-status="{{ lot.status | default('active') }}"
         data-title="{{ lot.region }}{% if lot.district %}, {{ lot.district }}{% endif %}"
         data-area="{{ lot.area_ha }}"
         {% if lot.event == 'gone' %}data-event="gone"{% endif %}
         {% if lot.is_backfill %}data-backfill="1"{% endif %}
         tabindex="0"
         aria-labelledby="lot-{{ lot.id }}-title">

  <div class="lot__row1">
    <div class="lot__chips">
    </div>
  </div>

  {# Grid: content left (1fr), actions right (auto), top-aligned #}
  <div class="lot__content-grid">
    <div class="lot__content">
      <h3 class="lot__title" id="lot-{{ lot.id }}-title">
        {{ lot.region }}{% if lot.district %}, {{ lot.district }}{% endif %}
      </h3>
      <p class="lot__meta">{{ lot.area_ha | replace('.', ',') }} га · {{ lot.category }}</p>
      {% if lot.vri %}
        <p class="lot__vri" title="Вид разрешённого использования">ВРИ: {{ lot.vri }}</p>
      {% endif %}

      <span class="lot__cad">
        <button type="button" data-copy="{{ lot.cadastral_no }}" class="lot__cad-copy" aria-label="Скопировать кадастровый номер" title="Скопировать">{{ lot.cadastral_no }}</button>
        {# hiq3: дата через format_date_ru — «17 марта 2026» без времени, без babel #}
        <span class="lot__appeared" title="Дата создания в ФИС">· {{ lot.date_create | dateformat }}</span>
        {% if lot.has_registry_date %}<span class="lot__registry" title="Дата постановки на учёт в ЕГРН"> · ЕГРН {{ lot.date_registry | dateformat }}</span>{% endif %}
      </span>

      {# hiq3: ОГВ без text-transform uppercase — см. lot__ogv в CSS #}
      {% if lot.ogv %}<p class="lot__ogv" title="Орган государственной власти">ОГВ: {{ lot.ogv }}</p>{% endif %}
    </div>

    <div class="lot__actions-col">
      {% if session.expired %}
      <span class="btn btn--primary btn--sm btn--disabled" role="link" tabindex="0" aria-disabled="true">
        Открыть
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
      </span>
      {% else %}
      <a class="btn btn--primary btn--sm" href="{{ lot.url }}" target="_blank" rel="noopener">
        Открыть
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
      </a>
      {% endif %}
      {% if lot.url_cad_map %}
      <a class="btn btn--sm" href="{{ lot.url_cad_map }}" target="_blank" rel="noopener">
        На карту Роскадастр ↗
      </a>
      {% endif %}
    </div>
  </div>

  <div class="lot__details">
    <div class="lot__details-row">
      {% if lot.external_id %}
      <dl class="lot__kv">
        <dt>ID на сайте</dt>
        <dd>{{ lot.external_id }}</dd>
      </dl>
      {% endif %}
    </div>

  </div>
</article>
