{# ========================================================================
   _lot_poster.html.jinja — poster-карточка (для горячих/тёплых лотов).
   Используется как полный фрагмент SSE-event "lot.new" — сервер шлёт <article>…</article>.
   Ожидает переменную `lot` в контексте.
   ======================================================================== #}
<article class="lot lot--poster"
         id="lot-{{ lot.id }}"
         data-lot-id="{{ lot.id }}"
         data-temp="{{ lot.temp }}"
         data-seen="{{ 'true' if lot.is_seen else 'false' }}"
         data-status="{{ lot.status | default('active') }}"
         {% if lot.event == 'gone' %}data-event="gone"{% endif %}
         data-appeared-at="{{ lot.appeared_at_epoch_ms }}"
         tabindex="0"
         aria-labelledby="lot-{{ lot.id }}-title">

  <div class="lot__row1">
    <span class="lot__age" data-role="age" title="{{ lot.appeared_at_iso }}">{{ lot.age_initial_hhmmss }}</span>
    <div class="lot__chips">
      {% if not lot.is_seen %}<span class="chip chip--new" aria-label="Новый лот">NEW</span>{% endif %}
      {% if lot.in_subscribed_subjects %}<span class="chip chip--cool" title="В подписанных субъектах">подписан</span>{% endif %}
      <button class="starbtn chip--star" type="button"
              data-action="star" data-lot-id="{{ lot.id }}"
              hx-post="/lots/{{ lot.id }}/star" hx-swap="none"
              aria-pressed="{{ 'true' if lot.is_starred else 'false' }}"
              aria-label="{{ 'Убрать из избранного' if lot.is_starred else 'В избранное' }}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.1 6.3 7 1-5 4.9 1.2 6.8L12 17.8 5.7 21l1.2-6.8-5-4.9 7-1L12 2Z"/></svg>
      </button>
    </div>
  </div>

  <h3 class="lot__title" id="lot-{{ lot.id }}-title">
    {{ lot.region }}{% if lot.district %}, {{ lot.district }}{% endif %}
  </h3>
  <p class="lot__meta">{{ lot.area_ha | replace('.', ',') }} га · {{ lot.category }}</p>
  {% if lot.vri %}
    <p class="lot__vri" title="Вид разрешённого использования">ВРИ: {{ lot.vri }}</p>
  {% endif %}

  <span class="lot__cad">
    <span data-copy="{{ lot.cadastral_no }}">{{ lot.cadastral_no }}</span>
    <button class="copy" type="button" data-copy="{{ lot.cadastral_no }}"
            aria-label="Скопировать кадастровый номер">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
    </button>
  </span>

  {% if lot.ogv %}<p class="lot__ogv" title="Орган государственной власти">ОГВ: {{ lot.ogv }}</p>{% endif %}

  <div class="lot__cta">
    <a class="btn btn--primary" href="{{ lot.url }}" target="_blank" rel="noopener"
       {% if session.expired %}aria-disabled="true" tabindex="-1" style="pointer-events:none; opacity:0.5"{% endif %}>
      Открыть на сайте
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
    </a>
    <button class="btn btn--ghost btn--sm" type="button" data-action="expand">▼ Детали</button>
  </div>

  {# Hidden until expanded #}
  <div class="lot__details">
    <div class="lot__details-row">
      <dl class="lot__kv">
        <dt>Появился</dt>
        <dd>{{ lot.published_at_human }}</dd>
      </dl>
      {% if lot.external_id %}
      <dl class="lot__kv">
        <dt>ID на сайте</dt>
        <dd>{{ lot.external_id }}</dd>
      </dl>
      {% endif %}
    </div>
    <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top: 12px;">
      <button class="btn btn--sm" type="button"
              data-copy="{{ lot.cadastral_no }} · {{ lot.region }}{% if lot.district %}, {{ lot.district }}{% endif %} · {{ lot.area_ha | replace('.', ',') }} га">
        📋 Скопировать всё для заявки
      </button>
      {% if lot.url_pkk %}
        <a class="btn btn--sm" href="{{ lot.url_pkk }}" target="_blank" rel="noopener">
          На карту ПКК Росреестра ↗
        </a>
      {% endif %}
    </div>

  </div>
</article>
