{# ========================================================================
   _header_status.html.jinja — содержимое #header-status
   Сервер шлёт этот фрагмент через SSE-event "status" каждый цикл / при
   изменении. Рендерит .status чип («Мониторинг активен» / warning / error /
   paused) + divider + «Последний новый:». Состояние полностью server-driven
   через monitor.state. lw5s убрал дублирующий pulse-dot индикатор.
   ======================================================================== #}
<span class="status" data-state="{{ monitor.state }}"
      title="{% if monitor.state == 'active' %}Все системы в норме{% elif monitor.state == 'warning' %}Сессия скоро истечёт{% elif monitor.state == 'error' %}Сессия истекла{% elif monitor.state == 'awaiting_backfill' %}Идёт первоначальное заполнение реестра{% elif monitor.state == 'checking' %}Ожидание ответа от сайта{% else %}Пауза{% endif %}">
  <span class="status__dot" aria-hidden="true"></span>
  {% if monitor.state == 'active' %}Мониторинг активен
  {% elif monitor.state == 'warning' %}Сессия истекает в {{ monitor.expires_at_hhmm }}
  {% elif monitor.state == 'error' %}Сессия истекла, нужен вход
  {% elif monitor.state == 'awaiting_backfill' %}Заполняется реестр…
  {% elif monitor.state == 'checking' %}Опрашиваю сайт…
  {% else %}Пауза{% endif %}
</span>

<span class="header-divider" aria-hidden="true"></span>
<span style="font-size: 0.8125rem; color: var(--ink-2);">
  Последний новый:
  <b>{{ monitor.last_new_human }}</b>
</span>
{# bd-bi7i: чип «Громче через ...» убран из UI — пользователю смысл непонятен,
   плюс он триггерился на backfilled-лотах (исторический догон). После
   backfill-фильтра по was_new сам факт эскалации стал семантически корректным,
   но текстовое UI оставили скрытым до согласования формулировки. #}
