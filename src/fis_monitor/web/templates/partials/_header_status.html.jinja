{# ========================================================================
   _header_status.html.jinja — содержимое #header-status
   Сервер шлёт этот фрагмент через SSE-event "status" каждый цикл / при изменении.

   hiq3 (ADR-050): countdown заменён на pulse-dot.
   data-state переключается JS-ом через SSE events cycle.started / cycle.done.
   ======================================================================== #}
<span class="status" data-state="{{ monitor.state }}"
      title="{% if monitor.state == 'active' %}Все системы в норме{% elif monitor.state == 'warning' %}Сессия скоро истечёт{% elif monitor.state == 'error' %}Сессия истекла{% else %}Пауза{% endif %}">
  <span class="status__dot" aria-hidden="true"></span>
  {% if monitor.state == 'active' %}Мониторинг активен
  {% elif monitor.state == 'warning' %}Сессия истекает в {{ monitor.expires_at_hhmm }}
  {% elif monitor.state == 'error' %}Сессия истекла, нужен вход
  {% else %}Пауза{% endif %}
</span>

{# pulse-dot: cycle.started → checking, cycle.done → idle #}
<span class="check-status" data-state="idle">
  <span class="check-dot" aria-hidden="true"></span>
  <span class="check-label">Жду</span>
</span>

<span class="header-divider" aria-hidden="true"></span>
<span style="font-size: 0.8125rem; color: var(--ink-2);">
  Последний новый:
  <b title="{{ monitor.last_new_human }}{% if monitor.last_new_at_hhmm %} ({{ monitor.last_new_at_hhmm }}){% endif %}">{{ monitor.last_new_human }}</b>
</span>
{# bd-bi7i: чип «Громче через ...» убран из UI — пользователю смысл непонятен,
   плюс он триггерился на backfilled-лотах (исторический догон). После
   backfill-фильтра по was_new сам факт эскалации стал семантически корректным,
   но текстовое UI оставили скрытым до согласования формулировки. #}
