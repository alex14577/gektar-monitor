{# ========================================================================
   _header_status.html.jinja — содержимое #header-status
   Сервер шлёт этот фрагмент через SSE-event "status" каждый цикл / при изменении.
   ======================================================================== #}
<span class="status" data-state="{{ monitor.state }}"
      title="{% if monitor.state == 'active' %}Все системы в норме{% elif monitor.state == 'warning' %}Сессия скоро истечёт{% elif monitor.state == 'error' %}Сессия истекла{% else %}Пауза{% endif %}">
  <span class="status__dot" aria-hidden="true"></span>
  {% if monitor.state == 'active' %}Мониторинг активен
  {% elif monitor.state == 'warning' %}Сессия истекает в {{ monitor.expires_at_hhmm }}
  {% elif monitor.state == 'error' %}Сессия истекла, нужен вход
  {% else %}Пауза{% endif %}
</span>

{% if monitor.interval_minutes > 0 %}
  <span class="countdown" aria-label="До следующей проверки">
    Проверка через
    <span data-countdown="{{ monitor.interval_minutes }}">{{ monitor.next_cycle_mmss }}</span>
  </span>
{% else %}
  <span class="countdown" aria-label="Непрерывный цикл">
    <span class="status__dot" style="background: var(--accent); display: inline-block; vertical-align: middle; margin-right: 4px;"></span>
    Без паузы между проверками
  </span>
{% endif %}

<span style="color: var(--muted); font-size: 0.8125rem;">·</span>
<span style="font-size: 0.8125rem; color: var(--ink-2);">
  Последний новый: <b>{{ monitor.last_new_human }}</b>
</span>
<span id="escalation-chip" class="esc-chip" hidden role="status" aria-live="polite">
  <span class="esc-chip__dot" aria-hidden="true"></span>
  <span data-role="esc-label">Громче через</span>
  <span data-role="esc-time" class="mono">0:60</span>
</span>
