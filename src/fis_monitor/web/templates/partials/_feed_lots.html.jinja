{# Feed lots partial — rendered by GET / (via feed.html.jinja) and POST /filters/view.
   htmx target: hx-target="#feed-wrapper" hx-swap="outerHTML"
   Variables: zones, archive_count, filters_active, health, filters, scope
   Optional: render_oob (bool, default false) — when true, appends an out-of-band
             <button id="filter-trigger" hx-swap-oob="true"> so htmx refreshes
             the subject-filter trigger button outside #feed on POST responses.

   Wrapper #feed-wrapper:
   The partial contains filter-bar + backfill-progress + #feed (lots list).
   htmx outerHTML на #feed дублировал бы filter-bar (response > 1 element), —
   поэтому swap-target = #feed-wrapper (вся обёртка целиком), а SSE-swap
   остаётся на внутреннем #feed (htmx-sse MutationObserver re-wires).
#}

{# Macro: correct Russian plural for "лот".
   Rule (matches JS lotPlural in app.js):
     n%10==1 && n%100!=11        → 'лот'
     n%10 in [2,3,4] && n%100 not in [12,13,14] → 'лота'
     else                        → 'лотов'
   Both the filter-bar counter and the zone title use this macro so server-render
   and live JS increment produce identical text. #}
{% macro lot_plural(n) -%}
{%- set r10 = n % 10 -%}
{%- set r100 = n % 100 -%}
{%- if r10 == 1 and r100 != 11 -%}лот
{%- elif r10 in [2, 3, 4] and r100 not in [12, 13, 14] -%}лота
{%- else -%}лотов
{%- endif -%}
{%- endmacro %}

<div id="feed-wrapper">

{# filter-bar — lot count only; sort order is hardcoded newest first.
   Uses lot_count (true total from DB, may exceed _FEED_PAGE_SIZE) instead of
   zones.today|length (which is capped at page size).  js-lot-count class allows
   the JS layer to increment the counter on each incoming lot.new SSE event.

   #feed-lot-count is ALWAYS rendered (even when lot_count=0) so that the first
   incoming SSE lot.new can find .js-lot-count and display the counter without
   requiring a page reload.  When lot_count==0 the element is hidden via CSS
   (data-count="0" → display:none) but remains in the DOM. #}
<div class="filter-bar">
  <div class="filter-bar__right">
    <span id="feed-lot-count" class="filter-bar__count js-lot-count" data-count="{{ lot_count }}">
      {{ lot_count }} {{ lot_plural(lot_count) }}
    </span>
  </div>
</div>

{# Backfill spinner — упрощённый вариант (hiq3): только spinner + label, без детализации region/page/lots #}
<div id="backfill-progress" style="display:none; text-align:center; padding: 10px 0 4px;">
  <span class="spinner-dots" aria-label="Загружаем каталог" style="display:inline-flex; vertical-align: middle;">
    <span class="spinner-dots__dot"></span>
    <span class="spinner-dots__dot"></span>
    <span class="spinner-dots__dot"></span>
  </span>
  <span style="margin-left: 8px; font-size: 0.875rem; color: var(--ink-2);">Загружаем каталог…</span>
</div>

<div id="feed"
     sse-swap="lot.new,lot.status"
     hx-target="this"
     hx-swap="afterbegin"
     aria-live="polite"
     aria-relevant="additions text">
  {# bd bjw4: sse-connect lives on #sse-root in base.html.jinja. htmx-sse's
     MutationObserver re-wires sse-swap when this fragment is replaced via
     hx-target=#feed (POST /filters/view), so removing the local
     sse-connect does not break live updates. #}

  {# LIST — all filtered lots regardless of age #}
  {% if zones.today %}
    <section class="zone" aria-label="Список лотов">
      <header class="zone__head">
        <h2 class="zone__title">Список</h2>
      </header>
      {% for lot in zones.today %}
        {% include "partials/_lot_poster.html.jinja" %}
      {% endfor %}

      {# Load-more trigger — INSIDE <section class="zone"> so appended cards land
         inside the same section.  outerHTML swap on #load-more-trigger replaces it
         with (new cards + fresh trigger) — all siblings of the existing cards,
         thus remaining inside the zone section. #}
      {# SSE coexistence: SSE prepends at afterbegin (top of #feed), load-more sits
         at the bottom of the zone section — the two DOM regions never collide. #}
      {% if next_cursor %}
      <div id="load-more-trigger"
           hx-get="/feed/more?cursor={{ next_cursor | urlencode }}&amp;shown={{ zones.today | length }}"
           hx-target="#load-more-trigger"
           hx-swap="outerHTML"
           hx-trigger="click from:#load-more-btn">
        <button id="load-more-btn" class="btn btn--ghost btn--full" type="button"
                style="justify-content: center; padding: 12px 16px;">
          <span style="display:inline-flex; gap:8px; align-items:center;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            Показать ещё
          </span>
        </button>
      </div>
      {% endif %}
    </section>
  {% endif %}

  {# Loading state: в БД ещё нет лотов и нет активных фильтров — сервис ещё качает первую партию. #}
  {# Скрывается через CSS как только в #feed появляется первый ребёнок-лот (через :has). #}
  {% if not zones.today and not filters_active and health.total_lots == 0 %}
  <div id="feed-loading" class="zone" style="text-align:center; padding:48px 24px;">
    <span class="spinner-dots" aria-label="Загружаем первую партию лотов" style="margin: 0 auto 12px;">
      <span class="spinner-dots__dot"></span>
      <span class="spinner-dots__dot"></span>
      <span class="spinner-dots__dot"></span>
    </span>
    <p style="margin:0; color: var(--ink-2);">Загружаем первую партию лотов…</p>
    <p style="margin:6px 0 0; color: var(--muted); font-size:0.875rem;">Сервис обращается к сайту, это может занять до минуты.</p>
  </div>
  {% endif %}

  {# Empty state for active filters #}
  {% if not zones.today and filters_active %}
    <div class="zone" style="text-align: center; padding: 48px 24px;">
      <p style="margin: 0; color: var(--ink-2);">Ничего не подходит под текущие фильтры.</p>
      <p style="margin: 6px 0 14px; color: var(--muted); font-size: 0.875rem;">Снимите часть, чтобы увидеть остальное.</p>
      <button class="btn" hx-post="/filters/clear" hx-target="#feed-wrapper" hx-swap="outerHTML">Очистить фильтры</button>
    </div>
  {% endif %}

</div>{# /#feed #}

</div>{# /#feed-wrapper #}

{# Out-of-band swap: update subject-filter trigger button (outside feed-wrapper) on POST.
   htmx processes elements with hx-swap-oob="true" as secondary swaps regardless
   of the primary hx-target. Only emitted when render_oob is truthy (POST path).
   GET / renders the button inline via _sidebar_filters.html.jinja instead.

   Important: hx-swap-oob fragments MUST be top-level siblings in the response,
   not nested inside feed-wrapper, otherwise htmx ignores them — that's why
   this block sits AFTER the feed-wrapper closing div above. #}
{% if render_oob | default(false) %}
{% set oob = true %}
{% include "partials/_filter_trigger.html.jinja" %}
{% endif %}
