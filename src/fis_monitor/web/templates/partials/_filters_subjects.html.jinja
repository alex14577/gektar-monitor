{# ========================================================================
   _filters_subjects.html.jinja — popover content for Субъект РФ filter.
   Loaded via htmx GET /filters/subjects → injected into #filter-subjects-menu.
   subjects: list of (site_id: int, name: str) tuples (ADR-031).
   ======================================================================== #}
<ul class="filter-subjects">
  {% for sid, name in subjects %}
  <li>
    <label class="check">
      <input type="checkbox"
             name="subjects"
             value="{{ sid }}"
             form="filters"
             {% if sid | string in selected_subjects %}checked{% endif %} />
      <span class="check__label">{{ name }}</span>
    </label>
  </li>
  {% endfor %}
</ul>
