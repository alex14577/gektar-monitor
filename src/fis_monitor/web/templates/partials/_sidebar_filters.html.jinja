{# ========================================================================
   _sidebar_filters.html.jinja — view-фильтры (НЕ сохраняются в config.json)
   POST в /filters/view возвращает обновлённую ленту через hx-swap.

   hiq3: C3 onboarding-hint при пустых subjects; M6 «Очистить» только при filters_active.
   ======================================================================== #}
<form id="filters"
      hx-post="/filters/view"
      hx-trigger="change delay:200ms, input changed delay:400ms"
      hx-target="#feed-wrapper"
      hx-swap="outerHTML">

  <div class="sidebar__group">
    <p class="sidebar__h">Субъект РФ</p>
    {% set oob = false %}
    {% include "partials/_filter_trigger.html.jinja" %}
    <div id="filter-subjects-menu" data-menu role="dialog" aria-label="Фильтр по субъектам" tabindex="-1" hidden></div>
  </div>

  {# M6: «Очистить фильтры» — показывать только при активных фильтрах #}
  {% if filters_active %}
  <div class="sidebar__group">
    <button class="btn btn--ghost btn--sm btn--full" type="button"
            hx-post="/filters/clear" hx-target="#feed-wrapper" hx-swap="outerHTML">
      Очистить фильтры
    </button>
  </div>
  {% endif %}
</form>

{% if license and license.expires_at %}
<div class="sidebar__group">
  {% if license.expired %}
  <p style="color: var(--err); font-size: .85rem;">
    Лицензия истекла &middot; {{ license.expires_at | dateformat }}
  </p>
  {% else %}
  <p style="color: var(--muted); font-size: .85rem;">
    Лицензия до {{ license.expires_at | dateformat }}
  </p>
  <p style="color: var(--muted); font-size: .85rem;">
    осталось {{ license.days_left }} дн.
  </p>
  {% endif %}
</div>
{% endif %}

<div class="sidebar__group">
  <p style="color: var(--muted); font-size: .85rem;">Версия {{ app_version }}</p>
</div>
