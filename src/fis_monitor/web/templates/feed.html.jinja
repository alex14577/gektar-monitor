{# ========================================================================
   feed.html — главный экран
   ======================================================================== #}
{% extends "base.html.jinja" %}

{% block sidebar %}
  {% include "partials/_sidebar_filters.html.jinja" %}
{% endblock %}

{% block main %}
  {# ------- Health widget ------- #}
  <div class="health" role="region" aria-label="Здоровье мониторинга">
    <span>Последний успешный цикл: <b>{{ health.last_cycle_human }}</b></span>
    <span>·</span>
    <span>Всего лотов в базе: <b>{{ '{:,}'.format(health.total_lots).replace(',', '\u00A0') }}</b></span>
    <span>·</span>
    <span>Последний новый: <b>{{ health.last_new_human }}</b></span>
    <span>·</span>
    <span>Вы за лентой: <b data-since-arrived>0 секунд</b></span>
  </div>

  {# ------- Session-warning banner (10 min before expiry) ------- #}
  {% if session.expires_soon %}
    <div class="banner banner--warn" role="status" aria-live="polite">
      <div style="display:flex; gap:10px; align-items:center;">
        <svg class="banner__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10.3 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12" y2="17"/>
        </svg>
        <div>
          <div class="banner__title">Сессия истекает в {{ session.expires_at_hhmm }}</div>
          <div style="font-size: 0.875rem; color: var(--ink-2);">Продлите заранее, чтобы не пропустить лот.</div>
        </div>
      </div>
      <div style="display:flex; gap:8px;">
        <button class="btn btn--sm" hx-post="/auth/refresh" hx-swap="none">Продлить сейчас</button>
        <button class="btn btn--ghost btn--sm" type="button" data-action="login-start">Войти заново</button>
      </div>
    </div>
  {% endif %}

  {# ------- Cycle-error banner ------- #}
  {% if last_cycle.error %}
    <div class="banner banner--err" role="status" aria-live="polite">
      <div style="display:flex; gap:10px; align-items:center;">
        <svg class="banner__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <div>
          <div class="banner__title">Цикл {{ last_cycle.started_at_hhmm }} не завершился</div>
          <div style="font-size: 0.875rem; color: var(--ink-2);">{{ last_cycle.error_short }}</div>
        </div>
      </div>
      <div style="display:flex; gap:8px;">
        <a class="btn btn--sm" href="/history#cycle-{{ last_cycle.id }}">Подробности</a>
        <button class="btn btn--ghost btn--sm" aria-label="Скрыть">✕</button>
      </div>
    </div>
  {% endif %}

  {# ------- Catch-up banner (после долгого простоя) ------- #}
  {% if catchup %}
    <div class="banner banner--info" role="status" aria-live="polite">
      <div style="display:flex; gap:10px; align-items:center;">
        <svg class="banner__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22a10 10 0 1 0-10-10"/><path d="M12 8v4l3 3"/></svg>
        <div>
          <div class="banner__title">Пока вас не было: {{ catchup.new_count }} новых лотов</div>
          <div style="font-size: 0.875rem; color: var(--ink-2);">
            с вашего визита {{ catchup.last_visit_human }}{% if catchup.detail %}, {{ catchup.detail }}{% endif %}
          </div>
        </div>
      </div>
      <div style="display:flex; gap:8px;">
        <button class="btn btn--sm" hx-post="/catchup/dismiss" hx-target="closest .banner" hx-swap="outerHTML">
          Перейти к первому новому
        </button>
        <button class="btn btn--ghost btn--sm" aria-label="Скрыть"
                hx-post="/catchup/dismiss" hx-target="closest .banner" hx-swap="outerHTML">✕</button>
      </div>
    </div>
  {% endif %}

  {# ------- The feed itself ------- #}
  <div id="feed"
       hx-ext="sse"
       sse-connect="/events"
       sse-swap="lot.new,lot.status"
       hx-target="this"
       hx-swap="afterbegin"
       aria-live="polite"
       aria-relevant="additions text">

    {# HOT (≤ 1 hour) #}
    {% if zones.hot %}
      <section class="zone zone--hot" aria-label="Горячее (новее 1 часа)">
        <header class="zone__head">
          <h2 class="zone__title">🔥 Горячее <span class="zone__title-count">· {{ zones.hot|length }} лот{{ 'а' if zones.hot|length in [2,3,4] else ('' if zones.hot|length == 1 else 'ов') }} · ≤ 1 часа</span></h2>
        </header>
        {% for lot in zones.hot %}
          {% include "partials/_lot_poster.html.jinja" %}
        {% endfor %}
      </section>
    {% endif %}

    {# TODAY (1h–24h) #}
    {% if zones.today %}
      <section class="zone" aria-label="Сегодня">
        <header class="zone__head">
          <h2 class="zone__title">Сегодня <span class="zone__title-count">· {{ zones.today|length }} лот{{ 'а' if zones.today|length in [2,3,4] else ('' if zones.today|length == 1 else 'ов') }} · 1 ч – 24 ч</span></h2>
        </header>
        {% for lot in zones.today %}
          {% include "partials/_lot_list.html.jinja" %}
        {% endfor %}
      </section>
    {% endif %}

    {# Loading state: в БД ещё нет лотов и нет активных фильтров — сервис ещё качает первую партию. #}
    {# Скрывается через CSS как только в #feed появляется первый ребёнок-лот (через :has). #}
    {% if not zones.hot and not zones.today and not filters_active and health.total_lots == 0 %}
    <div id="feed-loading" class="zone" style="text-align:center; padding:48px 24px;">
      <span class="spinner-dots" aria-label="Загружаем первую партию лотов" style="margin: 0 auto 12px;">
        <span class="spinner-dots__dot"></span>
        <span class="spinner-dots__dot"></span>
        <span class="spinner-dots__dot"></span>
      </span>
      <p style="margin:0; color: var(--ink-2);">Загружаем первую партию лотов…</p>
      <p style="margin:6px 0 0; color: var(--muted); font-size:0.875rem;">Сервис обращается к сайту, это может занять до минуты.</p>
    </div>
    {% endif %}

    {# ARCHIVE (older + reveal-on-demand) — скрыто пока нечего показывать (archive_count stub=0). #}
    {% if archive_count and archive_count > 0 %}
    <section class="zone zone--archive" aria-label="Архив">
      <button class="btn btn--ghost btn--full" type="button"
              hx-get="/lots?page=2"
              hx-target="closest .zone" hx-swap="outerHTML"
              style="justify-content: space-between; padding: 12px 16px;">
        <span style="display:inline-flex; gap:10px; align-items:center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          Показать ещё <b style="margin-left: 4px;">{{ archive_count }}</b> старых лотов из базы
        </span>
        <span style="color: var(--muted); font-size: 0.8125rem;">пагинация по 50</span>
      </button>
    </section>
    {% endif %}

  </div>{# /#feed #}

  {# Empty state for active filters #}
  {% if not zones.hot and not zones.today and filters_active %}
    <div class="zone" style="text-align: center; padding: 48px 24px;">
      <p style="margin: 0; color: var(--ink-2);">Ничего не подходит под текущие фильтры.</p>
      <p style="margin: 6px 0 14px; color: var(--muted); font-size: 0.875rem;">Снимите часть, чтобы увидеть остальное.</p>
      <button class="btn" hx-post="/filters/clear" hx-target="body">Очистить фильтры</button>
    </div>
  {% endif %}
{% endblock %}
